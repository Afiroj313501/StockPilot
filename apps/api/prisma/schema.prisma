generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum MovementType {
  OPENING
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  LOST
  RECONCILIATION
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
  PARTIALLY_RECEIVED
  RECEIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique // always stored lowercase (enforced in Phase 3)
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships StoreMembership[]
  sessions    Session[]
  stockMovements StockMovement[]
  createdPurchases  PurchaseOrder[] @relation("PurchaseCreatedBy")
  approvedPurchases PurchaseOrder[] @relation("PurchaseApprovedBy")
  receivedReceipts PurchaseReceipt[]
  sales Sale[]

  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships StoreMembership[]
  setting      StoreSetting?
  categories   Category[]
  products     Product[]
  stockMovements StockMovement[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  sales          Sale[]
  payments       Payment[]
  nextSaleNumber Int       @default(1)
  nextPurchaseNumber Int             @default(1)

  @@map("stores")
}

model StoreMembership {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_memberships")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model StoreSetting {
  id                       String   @id @default(uuid())
  storeId                  String   @unique
  businessCategory         String?
  address                  String?
  phone                    String?
  contactEmail             String?
  currency                 String   @default("USD") @db.VarChar(3)
  timeZone                 String   @default("UTC")
  taxName                  String   @default("Tax")
  taxRatePercent           Decimal  @default(0) @db.Decimal(5, 2)
  taxInclusive             Boolean  @default(false)
  receiptFooter            String?
  allowNegativeStock       Boolean  @default(false)
  defaultLowStockThreshold Int      @default(5)
  defaultLeadTimeDays      Int      @default(7)
  onboardingCompletedAt    DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@map("store_settings")
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  storeId          String
  categoryId       String?
  name             String
  sku              String
  barcode          String?
  description      String?
  unit             String?
  costPrice        Decimal  @db.Decimal(12, 2)
  sellingPrice     Decimal  @db.Decimal(12, 2)
  stockQuantity    Int      @default(0)
  reorderThreshold Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  purchaseItems PurchaseOrderItem[]
  averageCost  Decimal?             @db.Decimal(12, 4) // moving weighted average; null = use costPrice
  receiptItems PurchaseReceiptItem[]
  saleItems SaleItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, name])
  @@index([storeId, categoryId])
  @@map("products")
}

model Supplier {
  id           String   @id @default(uuid())
  storeId      String
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  notes        String?
  leadTimeDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String         @id @default(uuid())
  storeId      String
  supplierId   String
  number       Int
  status       PurchaseStatus @default(DRAFT)
  notes        String?
  expectedDate DateTime?      @db.Date
  createdById  String
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("PurchaseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items      PurchaseOrderItem[]
  receipts   PurchaseReceipt[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockMovement {
  id             String       @id @default(uuid())
  storeId        String
  productId      String
  type           MovementType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  referenceType  String?
  referenceId    String?
  actorUserId    String
  idempotencyKey String
  createdAt      DateTime     @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, productId, createdAt])
  @@index([storeId, createdAt])
  @@map("stock_movements")
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  storeId         String
  purchaseOrderId String
  receivedById    String
  note            String?
  idempotencyKey  String
  createdAt       DateTime @default(now())

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User                  @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items         PurchaseReceiptItem[]

  @@unique([storeId, idempotencyKey])
  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String  @id @default(uuid())
  receiptId           String
  purchaseOrderItemId String
  productId           String
  quantity            Int
  unitCost            Decimal @db.Decimal(12, 2) // snapshot of the order line's cost

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([productId])
  @@map("purchase_receipt_items")
}

enum SaleStatus {
  COMPLETED
  VOIDED // reserved for a later chunk
}

enum PaymentMethod {
  CASH
  CARD // recorded manually; no gateway
  MOBILE
  OTHER
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model Sale {
  id             String        @id @default(uuid())
  storeId        String
  number         Int
  status         SaleStatus    @default(COMPLETED)
  cashierId      String
  customerName   String?
  // Snapshots of the store settings at the time of sale.
  currency       String        @db.VarChar(3)
  taxName        String
  taxRatePercent Decimal       @db.Decimal(5, 2)
  taxInclusive   Boolean
  subtotal       Decimal       @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  discountTotal  Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  idempotencyKey String
  createdAt      DateTime      @default(now())

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cashier  User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]

  @@unique([storeId, number])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([storeId, cashierId])
  @@map("sales")
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  productId     String
  productName   String // snapshot
  productSku    String // snapshot
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2) // snapshot
  unitCost      Decimal @db.Decimal(12, 4) // snapshot of averageCost, else costPrice
  lineSubtotal  Decimal @db.Decimal(12, 2)
  discountShare Decimal @db.Decimal(12, 2)
  taxShare      Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid())
  storeId   String
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2) // applied to the sale
  tendered  Decimal       @db.Decimal(12, 2)
  change    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("payments")
}