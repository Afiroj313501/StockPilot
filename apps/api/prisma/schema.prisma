generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum MovementType {
  OPENING
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  LOST
  RECONCILIATION
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
  PARTIALLY_RECEIVED
  RECEIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique // always stored lowercase (enforced in Phase 3)
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships StoreMembership[]
  sessions    Session[]
  stockMovements StockMovement[]
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersSubmitted PurchaseOrder[] @relation("PurchaseOrderSubmittedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PurchaseOrderApprovedBy")

  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships StoreMembership[]
  setting      StoreSetting?
  categories   Category[]
  products     Product[]
  stockMovements StockMovement[]
  suppliers   Supplier[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderCounter PurchaseOrderCounter?

  @@map("stores")
}

model StoreMembership {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_memberships")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model StoreSetting {
  id                       String   @id @default(uuid())
  storeId                  String   @unique
  businessCategory         String?
  address                  String?
  phone                    String?
  contactEmail             String?
  currency                 String   @default("USD") @db.VarChar(3)
  timeZone                 String   @default("UTC")
  taxName                  String   @default("Tax")
  taxRatePercent           Decimal  @default(0) @db.Decimal(5, 2)
  taxInclusive             Boolean  @default(false)
  receiptFooter            String?
  allowNegativeStock       Boolean  @default(false)
  defaultLowStockThreshold Int      @default(5)
  defaultLeadTimeDays      Int      @default(7)
  onboardingCompletedAt    DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@map("store_settings")
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  storeId          String
  categoryId       String?
  name             String
  sku              String
  barcode          String?
  description      String?
  unit             String?
  costPrice        Decimal  @db.Decimal(12, 2)
  sellingPrice     Decimal  @db.Decimal(12, 2)
  stockQuantity    Int      @default(0)
  reorderThreshold Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, name])
  @@index([storeId, categoryId])
  @@map("products")
}

model Supplier {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@map("suppliers")
}

model PurchaseOrderCounter {
  storeId    String @id
  nextNumber Int    @default(1)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@map("purchase_order_counters")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  storeId     String
  supplierId  String
  number      String
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdById String
  submittedById String?
  approvedById String?
  createdAt   DateTime            @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?
  updatedAt   DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy User? @relation("PurchaseOrderSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines PurchaseOrderLine[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  quantityReceived Int      @default(0)
  unitCost        Decimal  @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model StockMovement {
  id             String       @id @default(uuid())
  storeId        String
  productId      String
  type           MovementType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  referenceType  String?
  referenceId    String?
  actorUserId    String
  idempotencyKey String
  createdAt      DateTime     @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, productId, createdAt])
  @@index([storeId, createdAt])
  @@map("stock_movements")
}
