{
  "name": "stockpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "StockPilot AI - inventory, POS and smart reordering platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @stockpilot/api",
    "dev:web": "npm run dev -w @stockpilot/web",
    "build:web": "npm run build -w @stockpilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:selftest": "node scripts/scan-secrets.mjs --self-test",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
