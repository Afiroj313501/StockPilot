# ---- General ----
NODE_ENV=development

# ---- API ----
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stockpilot
DATABASE_URL=postgresql://stockpilot:change_me@localhost:5432/stockpilot

# ---- Auth (generate real values; never commit them) ----
SESSION_SECRET=replace_with_a_long_random_string

# ---- Optional AI provider (app works without these) ----
AI_PROVIDER=none
AI_API_KEY=
