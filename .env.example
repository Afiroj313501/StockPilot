# ---- General ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stockpilot
DATABASE_URL=postgresql://stockpilot:change_me@localhost:5432/stockpilot
TEST_DATABASE_URL=postgresql://stockpilot:change_me@localhost:5432/stockpilot_test

# ---- Auth ----
SESSION_SECRET=replace_with_a_long_random_string

# ---- Optional AI provider (the app works fully without it) ----
# "none" = built-in answers only.
# "openai-compatible" = any service with the OpenAI chat API (OpenAI, OpenRouter, Groq, Ollama...).
#   It needs AI_API_KEY and AI_MODEL. Without them the built-in answers are used.
AI_PROVIDER=none
AI_API_KEY=
# AI_MODEL=your-model-name
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=15000
